/*.new
/*.new.sha256
/*.old
/*.failed
/*.upgrade.json
/server/webui/dist/
/dist/

# JWT 签名密钥（运行时生成，存项目根，绝不提交）
/jwt.key
/proxy-pool.key

# 本地环境配置（含密码/密钥，不提交）
.env
.env.*

# 调度器运行/模拟产生的事件日志（测试产物，不提交）
*-events.csv

# bench 基准测试相关（本地产物，不提交）
/bench/
